# Opt-in analysis for extension code that must run on the current and the next Shopwell major.
#
# includes:
#     - vendor/shopwelllabs/phpstan-shopwell/future-compatibility.neon

services:
    -
        class: Shopwell\PhpStan\Rule\FutureCompatibility\AnnouncedTypeResolver
    -
        class: Shopwell\PhpStan\Rule\FutureCompatibility\ClassMovedUsage
    -
        class: Shopwell\PhpStan\Rule\FutureCompatibility\FutureClassMovedUsageRule
        tags: [phpstan.rules.rule]
    -
        class: Shopwell\PhpStan\Rule\FutureCompatibility\FutureClassMovedExpressionUsageRule
        tags: [phpstan.rules.rule]
    -
        class: Shopwell\PhpStan\Rule\FutureCompatibility\FutureCallSiteRule
        tags: [phpstan.rules.rule]
    -
        class: Shopwell\PhpStan\Rule\FutureCompatibility\FuturePropertyCompatibilityRule
        tags: [phpstan.rules.rule]
    -
        class: Shopwell\PhpStan\Rule\FutureCompatibility\FutureExtensionRule
        tags: [phpstan.rules.rule]
    -
        class: Shopwell\PhpStan\Type\FutureReturnTypeExtension
        tags: [phpstan.broker.expressionTypeResolverExtension]
    -
        class: Shopwell\PhpStan\Type\FuturePropertyTypeExtension
        tags: [phpstan.broker.expressionTypeResolverExtension]
