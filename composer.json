{
  "name": "shopwelllabs/phpstan-shopwell",
  "description": "PhpStan Rules for Shopwell",
  "type": "library",
  "license": "Apache-2.0",
  "require": {
    "php": "^8.2",
    "phpstan/phpstan": "^2",
    "symfony/polyfill-php84": "^1.31"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "v3.84.0",
    "phpstan/extension-installer": "*",
    "phpunit/phpunit": "~11.3.6",
    "shopwell/core": "^6.6"
  },
  "autoload": {
    "psr-4": {
      "Shopwell\\PhpStan\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Shopwell\\PhpStan\\Tests\\": "tests/"
    },
    "classmap": [
      "tests/Rule/fixtures",
      "tests/Rule/BestPractise/fixtures",
      "tests/Type/fixtures"
    ]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "phpstan/extension-installer": true,
      "symfony/runtime": false
    },
    "audit": {
      "block-insecure": false
    }
  },
  "extra": {
    "phpstan": {
      "includes": [
        "rules.neon"
      ]
    }
  }
}
